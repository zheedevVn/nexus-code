# Đặt các biến này trên server (env / secret), KHÔNG commit file .env thật.
# GCP_PROJECT_NUMBER la so project Google Cloud (public, KHONG phai secret)
# — lay tu Google Cloud Console sau khi tao OAuth client (xem README).
GCP_PROJECT_NUMBER=
PORT=8080
RATE_LIMIT_PER_MIN=30
# Chi dung khi test voi Gemini gia lap o local, de trong khi chay that:
# GEMINI_BASE=http://127.0.0.1:9000/v1beta
